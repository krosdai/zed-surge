#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
mise_bin="$HOME/.local/bin/mise"
cd "$repo_root"

echo "Installing mise if needed..."
if [[ ! -x "$mise_bin" ]]; then
  mkdir -p "$(dirname "$mise_bin")"
  mise_installer="$(mktemp)"
  trap 'rm -f "$mise_installer"' EXIT
  curl --fail --location --silent --show-error --output "$mise_installer" https://mise.run
  MISE_INSTALL_PATH="$mise_bin" sh "$mise_installer"
  rm -f "$mise_installer"
  trap - EXIT
fi

export PATH="$HOME/.local/bin:$HOME/.local/share/mise/shims:$PATH"
"$mise_bin" trust --yes "$repo_root/mise.toml"

profile_start="# >>> zed-surge mise tools >>>"
profile_end="# <<< zed-surge mise tools <<<"
touch "$HOME/.bash_profile"
profile_tmp="$(mktemp)"
trap 'rm -f "$profile_tmp"' EXIT
if ! awk -v start="$profile_start" -v end="$profile_end" '
  $0 == "# zed-surge mise tools" { old_lines = 3; next }
  old_lines > 0 { old_lines--; next }
  $0 == start { managed = 1; next }
  $0 == end && managed { managed = 0; next }
  !managed { print }
  END { if (managed) exit 1 }
' "$HOME/.bash_profile" > "$profile_tmp"
then
  echo "Refusing to replace an unterminated managed block in $HOME/.bash_profile." >&2
  exit 1
fi
cat >> "$profile_tmp" <<EOF
$profile_start
export PATH="\$HOME/.local/bin:\$HOME/.local/share/mise/shims:\$PATH"
$profile_end
EOF
cat "$profile_tmp" > "$HOME/.bash_profile"
rm -f "$profile_tmp"
trap - EXIT

echo "Installing pinned tools..."
"$mise_bin" install

echo "Installing JavaScript dependencies..."
"$mise_bin" exec -- pnpm install --frozen-lockfile

tree_sitter_dir="$(
  "$mise_bin" exec -- node -p \
    "require('path').dirname(require.resolve('tree-sitter-cli/package.json'))"
)"
tree_sitter_version="$(
  "$mise_bin" exec -- node -p "require('tree-sitter-cli/package.json').version"
)"
needs_tree_sitter_build=false
if ! "$tree_sitter_dir/tree-sitter" --version >/dev/null 2>&1; then
  needs_tree_sitter_build=true
fi

apt_packages=()
if ! command -v git-lfs >/dev/null 2>&1; then
  apt_packages+=(git-lfs)
fi
if [[ "$needs_tree_sitter_build" == true ]]; then
  for package in build-essential libclang-dev; do
    if ! dpkg-query -W -f='${Status}' "$package" 2>/dev/null | grep -Fq 'ok installed'; then
      apt_packages+=("$package")
    fi
  done
fi
if ((${#apt_packages[@]} > 0)); then
  apt_get=(apt-get)
  if ((EUID != 0)); then
    if ! command -v sudo >/dev/null 2>&1; then
      echo "Installing system packages requires root or sudo." >&2
      exit 1
    fi
    apt_get=(sudo apt-get)
  fi
  "${apt_get[@]}" update
  "${apt_get[@]}" install -y "${apt_packages[@]}"
fi
git lfs install --skip-repo

if [[ "$needs_tree_sitter_build" == true ]]; then
  echo "Building a Debian-compatible tree-sitter CLI..."
  "$mise_bin" install rust@1.97.1
  "$mise_bin" exec rust@1.97.1 -- \
    cargo install --locked --version "$tree_sitter_version" tree-sitter-cli
  rm -f "$tree_sitter_dir/tree-sitter"
  install -m 0755 "$HOME/.cargo/bin/tree-sitter" "$tree_sitter_dir/tree-sitter"
fi
"$tree_sitter_dir/tree-sitter" --version

echo "Orb setup complete."
"$mise_bin" exec -- node --version
"$mise_bin" exec -- pnpm --version
